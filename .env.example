# Server Configuration
PORT=5050
JWT_SECRET=super_secret_monochrome_twilio_key_2026

# Twilio Master Configuration
# Found on Twilio Console Dashboard: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your active purchased Twilio Phone Number (with country code, e.g. +19856022321)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Twilio API Key & Secret (Account -> API Keys -> Create API Key, standard type)
TWILIO_API_KEY=SKXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_API_SECRET=your_twilio_api_secret_here

# Twilio TwiML App SID (Develop -> Voice -> TwiML Apps -> Create App)
# Set Voice Request URL to https://<YOUR_DEPLOYED_URL_OR_NGROK>/api/twilio/voice (HTTP POST)
TWILIO_TWIML_APP_SID=APXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Set this when deployed in production (e.g. https://my-calling-app.onrender.com)
# BASE_URL=https://my-calling-app.onrender.com
